# ============================================
# Local Development Configuration
# ============================================
ENVIRONMENT=local
# OAuth provider credentials (stored in gumstack dashboard in production)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# For local testing, simulate an access token
LOCAL_ACCESS_TOKEN=your_test_access_token_here

# ============================================
# Gumstack Configuration (set by gumstack in production)
# ============================================
GUMSTACK_SERVER_ID=linkedin-mcp-server
# GUMSTACK_BACKEND_URL=https://api.gumstack.com
# GUMLOOP_BACKEND_URL=https://api.gumloop.com
